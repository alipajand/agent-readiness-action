{
  "name": "agent-readiness-action",
  "version": "1.2.0",
  "description": "GitHub Action wrapper for agent-readiness-kit CI audits",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist",
    "integrations:build": "pnpm --filter ./integrations build",
    "integrations:test": "pnpm --filter ./integrations test",
    "integrations:typecheck": "pnpm --filter ./integrations typecheck"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^4.1.11",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
